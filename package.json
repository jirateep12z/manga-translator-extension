{
  "name": "manga-translator-extension",
  "description": "Translate manga in place with a cross-site story memory, using OpenRouter or Ollama.",
  "author": "@jirateep12z",
  "license": "MIT",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run fetch-ocr-models && npm run check-tailwind-sources && tsc -b && vite build && vite build --config vite.content.config.ts && vite build --config vite.background.config.ts && npm run check-extension-build",
    "fetch-ocr-models": "node scripts/fetch-ocr-models.mjs",
    "check-tailwind-sources": "node scripts/check-tailwind-sources.mjs",
    "check-extension-build": "node scripts/check-extension-build.mjs",
    "ocr-parity": "vite --config tools/ocr-parity/vite.config.ts",
    "lint": "eslint \"src/**/*.{js,ts,jsx,tsx,json,css,html}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,jsx,tsx,json,css,html}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,json,css,html}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@fontsource/itim": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "idb": "^8.0.4",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.76.0",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "1.31.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.11.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "5.5.0",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
